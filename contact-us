<style>
/* ============================================================
   THEME VARIABLES (LIGHT ONLY)
   ============================================================ */
:root{
  color-scheme: light;
  --bg: #ffffff;
  --text: #333333;
  --text-strong: #111111;
  --text-muted: #555555;
  --line: #eaeaea;
  --hover-bg: #f0f0f0;
  --shadow: rgba(0,0,0,0.02);
  --link: #0066cc;
  --link-hover: #004c99;
  --icon-fill: #111111;
  --header-bg: #ffffff;
  --code-bg: #f3f4f6;
  --code-text: #c2410c;
}

/* ============================================================
   BASE RESET
   ============================================================ */
*{
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html{
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
  max-width: 100%;
  overflow-x: hidden;
  background-color: #ffffff;
}

body{
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  background-color: var(--bg);
  color: var(--text);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  overflow-x: hidden;
  width: 100%;
  max-width: 100%;
  overflow-wrap: break-word;
}

a:focus-visible,
button:focus-visible{
  outline: 2px solid var(--text-strong);
  outline-offset: 2px;
  border-radius: 4px;
}

/* ============================================================
   TOP BAR / HEADER
   ============================================================ */
.top-bar{
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 24px;
  background-color: var(--header-bg);
  border-bottom: 1px solid var(--line);
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2px 4px var(--shadow);
}

.top-bar-left{
  display: flex;
  align-items: center;
  gap: 16px;
}

.back-link{
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-strong);
  text-decoration: none;
  padding: 8px;
  border-radius: 50%;
  transition: background-color 0.2s ease;
  -webkit-tap-highlight-color: transparent;
}

.back-link:hover{
  background-color: var(--hover-bg);
}

.back-link svg{
  width: 24px;
  height: 24px;
  stroke: currentColor;
  color: currentColor;
}

.site-name{
  font-size: 20px;
  font-weight: 600;
  color: var(--text-strong);
  letter-spacing: -0.3px;
}

.top-bar-right{
  display: flex;
  align-items: center;
  gap: 16px;
}

.feedback-btn{
  display: flex;
  align-items: center;
  gap: 8px;
  background: none;
  border: none;
  font-family: inherit;
  font-size: 15px;
  font-weight: 500;
  color: var(--text-strong);
  cursor: pointer;
  padding: 8px 12px;
  border-radius: 8px;
  transition: background-color 0.2s ease;
  -webkit-tap-highlight-color: transparent;
  touch-action: manipulation;
}

.feedback-btn:hover{
  background-color: var(--hover-bg);
}

.feedback-btn svg{
  width: 20px;
  height: 20px;
  fill: var(--icon-fill);
  color: var(--icon-fill);
}

/* ============================================================
   MAIN CONTENT
   ============================================================ */
.terms-container{
  max-width: 820px;
  margin: 0 auto;
  padding: 48px 24px 80px 24px;
  flex: 1;
  width: 100%;
  min-width: 0;
}

h1{
  font-size: 36px;
  font-weight: 500;
  color: var(--text-strong);
  margin-bottom: 24px;
  letter-spacing: -0.5px;
  line-height: 1.2;
}

.last-updated{
  font-size: 15px;
  color: var(--text-muted);
  margin-bottom: 16px;
}

.intro-text{
  font-size: 16px;
  color: var(--text);
  margin-bottom: 40px;
}

h2{
  font-size: 26px;
  font-weight: 500;
  color: var(--text-strong);
  margin-top: 40px;
  margin-bottom: 20px;
  letter-spacing: -0.3px;
  line-height: 1.3;
}

h3{
  font-size: 20px;
  font-weight: 600;
  color: var(--text-strong);
  margin-top: 32px;
  margin-bottom: 16px;
}

p{
  font-size: 16px;
  color: var(--text);
  margin-bottom: 18px;
}

ul, ol{
  margin-bottom: 24px;
  padding-left: 24px;
}

li{
  font-size: 16px;
  color: var(--text);
  margin-bottom: 12px;
}

li strong,
p strong{
  font-weight: 600;
  color: var(--text-strong);
}

p em,
li em{
  font-style: italic;
  color: var(--text);
}

a{
  color: var(--link);
  text-decoration: none;
  transition: color 0.2s ease;
}

a:hover{
  color: var(--link-hover);
  text-decoration: underline;
}

code{
  background: var(--code-bg);
  padding: 2px 6px;
  border-radius: 4px;
  font-size: 14px;
  font-family: 'SF Mono', Consolas, 'Courier New', monospace;
  color: var(--code-text);
  font-weight: 600;
}

/* ============================================================
   CONTACT PAGE SPECIFIC
   ============================================================ */
.contact-card{
  background: #f9fafb;
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 28px;
  margin-bottom: 32px;
}

.contact-card h2{
  margin-top: 0;
  margin-bottom: 16px;
}

.contact-email{
  display: inline-block;
  font-size: 22px;
  font-weight: 600;
  color: var(--text-strong);
  margin: 8px 0 12px;
  letter-spacing: -0.3px;
  word-break: break-all;
}

.contact-email a{
  color: var(--text-strong);
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 3px;
}

.contact-email a:hover{
  color: var(--link);
}

.contact-response{
  font-size: 14px;
  color: var(--text-muted);
  font-style: italic;
  margin-bottom: 0;
}

.contact-topics{
  list-style: none;
  padding-left: 0;
}

.contact-topics li{
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 16px;
}

.contact-topics .topic-icon{
  width: 24px;
  height: 24px;
  flex-shrink: 0;
  margin-top: 2px;
  stroke: #4b5563;
  fill: none;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.contact-topics .topic-text{
  flex: 1;
  min-width: 0;
}

.contact-topics .topic-text strong{
  display: block;
  margin-bottom: 2px;
}

.contact-topics .topic-text span{
  font-size: 14.5px;
  color: var(--text-muted);
}

.faq-inline{
  margin-top: 48px;
}

.faq-inline .faq-item{
  padding: 16px 0;
  border-bottom: 1px solid var(--line);
}

.faq-inline .faq-item:last-child{
  border-bottom: none;
}

.faq-inline .faq-q{
  font-size: 16px;
  font-weight: 600;
  color: var(--text-strong);
  margin-bottom: 6px;
}

.faq-inline .faq-a{
  font-size: 15px;
  color: var(--text);
  margin-bottom: 0;
  line-height: 1.6;
}

.cta-block{
  margin-top: 40px;
  padding-top: 32px;
  border-top: 1px solid var(--line);
  text-align: center;
}

.cta-block p{
  margin-bottom: 0;
}

/* ============================================================
   FOOTER — matches the wheel tool footer (2 rows, 6 links, icons)
   ============================================================ */
.site-footer{
  background-color:#ffffff;
  width:100%;
  max-width:100%;
  margin-top:34px;
  padding:24px 0 70px 0;
  overflow:hidden;
  border-top:1px solid #e5e5e5;
}

.footer-container{
  max-width:820px;
  margin:0 auto;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  padding:0 24px;
}

.footer-links-wrap{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:12px 0;
  width:100%;
  max-width:900px;
  margin:0 auto;
}

.footer-row{
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  justify-content:center;
  gap:16px 32px;
  width:100%;
}

.footer-item{
  display:flex;
  align-items:center;
  gap:8px;
  font-family:inherit;
  font-size:15px;
  font-weight:500;
  color:#5b4bc4;
  text-decoration:underline;
  text-decoration-thickness:1px;
  text-underline-offset:3px;
  transition:color 0.15s ease;
  text-align:center;
  background:none;
  border:none;
}

.footer-item:hover{
  color:#4338ca;
}

.footer-icon{
  width:18px;
  height:18px;
  stroke:#4b5563;
  color:#4b5563;
  flex-shrink:0;
  fill:none;
  stroke-width:2;
  stroke-linecap:round;
  stroke-linejoin:round;
}

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width: 900px){
  .terms-container{
    max-width: 100%;
  }
}

@media (max-width: 768px){
  .footer-row{
    gap:10px 16px;
  }
  .footer-item{
    font-size:14px;
  }
}

@media (max-width: 600px){
  .top-bar{
    padding: 12px 16px;
  }
  .site-name{
    font-size: 18px;
  }
  .feedback-btn span{
    display: none;
  }
  .terms-container{
    padding: 32px 16px 60px 16px;
  }
  h1{
    font-size: 28px;
  }
  h2{
    font-size: 22px;
  }
  h3{
    font-size: 18px;
  }
  p, li, .intro-text{
    font-size: 15.5px;
  }
  .contact-card{
    padding: 20px;
  }
  .contact-email{
    font-size: 19px;
  }
  .faq-inline .faq-q{
    font-size: 15.5px;
  }
  .faq-inline .faq-a{
    font-size: 14.5px;
  }
  .site-footer{
    padding: 20px 0 50px 0;
    margin-top: 30px;
  }
}

@media (max-width: 400px){
  .footer-row{
    gap:10px 12px;
  }
  .footer-item{
    font-size:13px;
    gap:6px;
  }
  .footer-icon{
    width:16px;
    height:16px;
  }
}

@media (max-width: 380px){
  .top-bar{
    padding: 10px 12px;
  }
  .site-name{
    font-size: 16px;
    letter-spacing: -0.2px;
  }
  .back-link svg{
    width: 20px;
    height: 20px;
  }
  h1{
    font-size: 24px;
  }
  h2{
    font-size: 20px;
  }
  h3{
    font-size: 17px;
  }
  p, li, .intro-text{
    font-size: 15px;
  }
  .terms-container{
    padding: 24px 14px 52px 14px;
  }
  .contact-card{
    padding: 16px;
  }
}

@media (max-width: 320px){
  .site-name{
    font-size: 14.5px;
  }
  h1{
    font-size: 22px;
  }
  h2{
    font-size: 18px;
  }
  h3{
    font-size: 16px;
  }
  p, li, .intro-text{
    font-size: 14.5px;
  }
  .contact-email{
    font-size: 17px;
  }
}

@media (min-width: 1440px){
  .terms-container{
    max-width: 880px;
  }
  .footer-container{
    max-width: 880px;
  }
}

@media (prefers-reduced-motion: reduce){
  html{scroll-behavior: auto;}
  *, *::before, *::after{
    animation-duration: 0.001ms !important;
    transition-duration: 0.001ms !important;
  }
}
</style>
